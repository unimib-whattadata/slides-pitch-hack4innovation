      "parameters": {
        "jsCode": "// Ottieni i dati dall'input\nconst inputData = items[0].json;\n\n// Estrai l'ID del messaggio nel formato corretto\nlet messageId = '';\n\n// Cerca prima nel campo id o messageId\nif (inputData.id) {\n  // Se il campo id contiene un indirizzo email, estrai solo la parte dell'ID\n  if (inputData.id.includes('@mail.gmail.com')) {\n    messageId = inputData.id.replace(/[<>]/g, '').split('@')[0];\n  } else {\n    messageId = inputData.id;\n  }\n} else if (inputData.messageId) {\n  // Stessa logica per messageId\n  if (inputData.messageId.includes('@mail.gmail.com')) {\n    messageId = inputData.messageId.replace(/[<>]/g, '').split('@')[0];\n  } else {\n    messageId = inputData.messageId;\n  }\n} else {\n  // Se non troviamo un ID chiaro, usiamo altri campi per la ricerca\n  messageId = 'search/' + encodeURIComponent(inputData.subject || '');\n}\n\n// Crea il link con il numero account corretto (5 invece di 0)\nconst emailLink = `https://mail.google.com/mail/u/5/#inbox/${messageId}`;\n\n// Restituisci i dati originali più il link all'email\nreturn [{\n  json: {\n    ...inputData,\n    emailLink: emailLink\n  }\n}];"
      },

        "jsCode": "// Gestione dei placeholder per i nodi Google Drive\nif ($json.placeholder === true) {\n  // Se è un placeholder, restituisci un oggetto con i campi necessari\n  return [{\n    json: {\n      webViewLink: `Non disponibile (nessun ${$json.type} trovato)`,\n      placeholder: true\n    }\n  }];\n}\n\n// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nconst binaryKeys = Object.keys(items[0].binary);\n\nconst keywords = ['cv', 'curriculum', 'resume', 'vitae', 'curr', 'curric', 'résumé', 'curiculum'];\n\nfor (const key of binaryKeys) {\n  const fileName = items[0].binary[key].fileName?.toLowerCase() || \"\";\n\n  if (keywords.some(k => fileName.includes(k))) {\n    return [{\n      json: {},\n      binary: {\n        CV0: items[0].binary[key] // Rinominato come CV0\n      }\n    }];\n  }\n}\n\n// Se non troviamo un CV, restituisci un placeholder\nreturn [{\n  json: {\n    placeholder: true,\n    type: 'CV',\n    text: 'Nessun CV trovato tra gli allegati.'\n  },\n  binary: {}\n}];"
      },

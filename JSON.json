    {
      "parameters": {
        "jsCode": "const binary = items[0].binary;\nconst output = [];\n\nconst cvKeywords = ['cv', 'resume', 'curriculum'];\nconst portfolioKeywords = ['portfolio'];\n\nlet foundCV = false;\nlet foundPortfolio = false;\nlet foundOther = false;\n\nfor (const [key, data] of Object.entries(binary)) {\n  let fileName = (data.fileName || '').toLowerCase();\n  let newKey = key;\n\n  if (cvKeywords.some(keyword => fileName.includes(keyword))) {\n    newKey = 'CV';\n    foundCV = true;\n  } else if (portfolioKeywords.some(keyword => fileName.includes(keyword))) {\n    newKey = 'Portfolio';\n    foundPortfolio = true;\n  } else {\n    newKey = 'Altro';\n    foundOther = true;\n  }\n\n  output.push({\n    json: {},\n    binary: {\n      [newKey]: data\n    }\n  });\n}\n\nif (!foundCV) {\n  output.push({\n    json: { placeholder: true, type: 'CV' },\n    binary: {}\n  });\n}\n\nif (!foundPortfolio) {\n  output.push({\n    json: { placeholder: true, type: 'Portfolio' },\n    binary: {}\n  });\n}\n\nif (!foundOther) {\n  output.push({\n    json: { placeholder: true, type: 'Altro' },\n    binary: {}\n  });\n}\n\nreturn output;\n"
      },
